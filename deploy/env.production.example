# PLACEHOLDERS ONLY. On the server, copy this template to the repo-root .env.local.
# Fill it privately; never commit, paste, print or share the completed file/config.
SITE_HOST=YOUR_APP.duckdns.org

# Generate separate secrets on the server: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_NEW_64_HEX_CHARACTER_SESSION_SECRET
SESSION_SECRET_PREVIOUS=
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_PASSWORD
# Compose expands POSTGRES_PASSWORD here. Hex needs no URL escaping; keep the user/db/host.
DATABASE_URL=postgres://quarrel:${POSTGRES_PASSWORD}@postgres:5432/quarrel
COOKIE_SECURE=true
TRUST_PROXY=true

# "auto" is the real-AI mode accepted by config.ts; "real" is not a valid value.
# First launch with demo if you want to check connectivity without provider calls.
JUDGE_AI_MODE=auto
GEMINI_API_KEY=REPLACE_WITH_TEXT_API_KEY
GEMINI_MODEL=gemini-3.6-flash
# Same key, different model; confirm free-tier availability in your Google project.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Separate voice key. Leave empty to permit browser voice instead of server TTS.
GEMINI_TTS_API_KEY=REPLACE_WITH_SEPARATE_TTS_API_KEY
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_TIMEOUT_MS=20000
TTS_CACHE_MAX_BYTES=2097152
JUDGE_AI_TIMEOUT_MS=12000
LAWYER_AI_TIMEOUT_MS=12000
SUMMARY_AI_TIMEOUT_MS=12000
LAWYER_WORK_TIMEOUT_MS=30000
SUMMARY_WORK_TIMEOUT_MS=30000
DEADLINE_POLL_MS=250

# Configurable assumption: daily quota resets at the next Pacific midnight, DST-aware.
AI_QUOTA_RESET_TZ=America/Los_Angeles
ROOM_CREATE_LIMIT_PER_HOUR=10
ROOM_JOIN_LIMIT_PER_HOUR=30
