# demo = no provider calls, auto = real AI when keys are set
JUDGE_AI_MODE=demo

GEMINI_API_KEY=
GEMINI_MODEL=
# Optional same-key free-tier fallback; check model availability for your project.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Dev Redis container: docker run -d --name quarrel-redis -p 6380:6379 redis:7
REDIS_URL=redis://localhost:6380
API_PORT=

# Signs session tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Optional: the previous secret while rotating, so existing sessions keep working.
SESSION_SECRET_PREVIOUS=
# true only when served over HTTPS (adds the Secure flag to cookies). Default false.
COOKIE_SECURE=
DATABASE_URL=postgres://quarrel:quarrel@localhost:5433/quarrel

# Optional server voice; separate from the text-model key. Demo always uses browser fallback.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_TIMEOUT_MS=20000
TTS_CACHE_MAX_BYTES=2097152

# Daily free-tier limits reset at midnight in this timezone (configurable assumption).
AI_QUOTA_RESET_TZ=America/Los_Angeles
ROOM_CREATE_LIMIT_PER_HOUR=10
ROOM_JOIN_LIMIT_PER_HOUR=30
# Enable only behind the trusted nginx proxy (Compose overrides this to true).
TRUST_PROXY=false
